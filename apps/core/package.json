    "db:migrate": "drizzle-kit migrate",
    "test": "vitest run"
  },
  "dependencies": {
    "@fastify/cors": "^11.1",
    "@fastify/rate-limit": "^10.3.0",
    "@fastify/websocket": "^11.1",
    "@zctl/config": "workspace:*",
    "@zctl/protocol": "workspace:*",
    "@zctl/shared": "workspace:*",
    "dotenv": "^17.4",
    "drizzle-orm": "^0.45",
    "fastify": "^5.3",
    "jsonwebtoken": "^9.0.3",
    "pino": "^10.3",
    "pino-pretty": "^13.1",
    "postgres": "^3.4",
    "zod": "^4.4"
  },
  "devDependencies": {
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^25.7",
    "drizzle-kit": "^0.31",
    "tsx": "^4.19",
    "typescript": "^6.0",
    "vitest": "^4.1"
